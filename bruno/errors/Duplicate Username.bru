meta {
  name: Duplicate Username
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user/new
  body: json
  auth: none
}


body:json {
  { "username": "{{username}}", "password": "{{password}}" }
}
tests {
  test("409 username_taken", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error.code).to.equal("username_taken");
  });
}
