meta {
  name: URL Too Long
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/new
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  { "url": "{{longUrl}}" }
}
script:pre-request {
  bru.setVar("longUrl", "https://long.example/" + "a".repeat(4097 - "https://long.example/".length));
}

tests {
  test("400 url_too_long", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal("url_too_long");
  });
}
