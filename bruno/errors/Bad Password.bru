meta {
  name: Bad Password
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/user/token
  body: json
  auth: none
}


body:json {
  { "username": "{{username}}", "password": "definitely-wrong" }
}
tests {
  test("401 invalid_credentials", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("invalid_credentials");
  });
}
