meta {
  name: 01 Create User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/user/new
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:pre-request {
  bru.setVar("username", "u" + Math.random().toString(36).slice(2, 12));
  bru.setVar("password", "pw-" + Math.random().toString(36).slice(2, 14));
}

tests {
  test("201 with lowercased username", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().username).to.equal(bru.getVar("username"));
    expect(res.getBody().id).to.be.a("number");
  });
}
