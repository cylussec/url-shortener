meta {
  name: 02 Get Token
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/user/token
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setVar("token", res.getBody().token);
}

tests {
  test("201 with non-expiring token", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().token).to.be.a("string");
    expect(res.getBody().expires_at).to.equal(null);
  });
}
