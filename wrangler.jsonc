{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "url-shortener",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "vars": {
    // Public base for short_url. Replace with your workers.dev URL or custom domain.
    // Overridden locally by .dev.vars.
    "BASE_URL": "https://url-shortener.example.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "url-shortener",
      // Replace with the id printed by `wrangler d1 create url-shortener`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    { "name": "RL_USER_NEW_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_TOKEN_IP", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_TOKEN_USER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_NEW_URL", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
  ],
  "triggers": { "crons": ["17 3 * * *"] },
}
